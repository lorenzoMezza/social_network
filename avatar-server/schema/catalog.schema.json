{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterkey.app/schema/avatar-catalog.v1.json",
  "title": "Avatar catalog",
  "description": "Every item an avatar can wear, with its files per body shape and the rules of what covers what. Generated by scripts/build-library.mjs; file paths are relative to the files URL (GET /v1/files/<path>).",
  "type": "object",
  "required": ["format", "version", "bodyShapes", "categories", "palettes", "emotes", "items"],
  "properties": {
    "format": { "const": "masterkey.avatar-catalog" },
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "attribution": { "type": "string" },
    "bodyShapes": { "type": "array", "items": { "type": "string" } },
    "categories": {
      "description": "The slots, in display order (CATEGORIES in shared/avatarFormat.js)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "group", "kind"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "group": { "enum": ["body", "face", "hair", "top", "bottom", "shoes", "accessories"] },
          "kind": { "enum": ["model", "texture"], "description": "model: a GLB rigged on the shared skeleton; texture: a PNG painted on the face" },
          "required": { "type": "boolean" },
          "covers": { "type": "array", "items": { "$ref": "#/$defs/bodyPart" }, "description": "Bare body parts hidden under an item of this slot" }
        }
      }
    },
    "palettes": {
      "type": "object",
      "properties": {
        "skin": { "type": "array", "items": { "type": "string" } },
        "hair": { "type": "array", "items": { "type": "string" } },
        "eyes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "emotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "files"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "loop": { "type": "boolean" },
          "files": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Body shape ID → GLB with one animation on the shared skeleton" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "collection", "representations", "hides", "replaces", "removesDefaultHiding", "license"],
        "properties": {
          "id": { "type": "string", "description": "<collection>:<name>, stable" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "collection": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "thumbnail": { "type": ["string", "null"] },
          "representations": {
            "description": "Body shape ID → files. An item is wearable only on the shapes listed.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "model": { "type": "string", "description": "GLB (model items)" },
                "texture": { "type": "string", "description": "PNG (face items)" },
                "mask": { "type": "string", "description": "PNG, dark where the eye colour applies (eyes)" },
                "parts": { "type": "array", "items": { "$ref": "#/$defs/bodyPart" }, "description": "Bare body parts the model has geometry of its own for (slots with covers): its slot hides only these" }
              }
            }
          },
          "hides": { "type": "array", "items": { "type": "string" }, "description": "Slots and body parts not drawn while this is worn" },
          "replaces": { "type": "array", "items": { "type": "string" }, "description": "Slots taken off when this is put on" },
          "removesDefaultHiding": { "type": "array", "items": { "$ref": "#/$defs/bodyPart" }, "description": "Body parts its slot normally covers that stay visible" },
          "license": { "type": "string" },
          "source": { "type": "object", "properties": { "repository": { "type": "string" }, "path": { "type": "string" }, "urn": { "type": "string" } } }
        }
      }
    }
  },
  "$defs": {
    "bodyPart": { "enum": ["head", "upper_body", "lower_body", "feet", "hands"] }
  }
}
